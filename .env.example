# Tenth Project — Environment Variables

# Supabase (optional for local dev — app uses local JSON store as fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI — OpenAI or AIML API (optional — app uses smart fallback when not set)
OPENAI_API_KEY=sk-...
# OR use AIML API:
# AIML_API_KEY=your-aiml-key
# AIML_BASE_URL=https://api.aimlapi.com/v1
OPENAI_MODEL=gpt-4o-mini

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_USER_ID=your-demo-supabase-user-uuid

# Stripe — Lifetime membership checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_LIFETIME_PRICE_ID=
NEXT_PUBLIC_SKOOL_URL=https://www.skool.com/tenthproject
NEXT_PUBLIC_WHATSAPP_VIP_URL=
NEXT_PUBLIC_MENTOR_BOOKING_URL=

# Resend — emails new enterprise leads to professor.cat.hk@gmail.com
# Without this key the enquiry is still saved; only the email is skipped.
RESEND_API_KEY=re_...
# Optional. Resend sandbox: Tenth Project <onboarding@resend.dev>
# Production: use a verified domain, e.g. Tenth Project <hello@professor-cat.com>
RESEND_FROM=Tenth Project <onboarding@resend.dev>
# Optional override; default is professor.cat.hk@gmail.com
LEAD_NOTIFY_EMAIL=professor.cat.hk@gmail.com
