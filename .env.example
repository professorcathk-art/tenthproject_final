# Tenth Project — Environment Variables

# Supabase (optional for local dev — app uses local JSON store as fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI — OpenAI or AIML API (optional — app uses smart fallback when not set)
OPENAI_API_KEY=sk-...
# OR use AIML API:
# AIML_API_KEY=your-aiml-key
# AIML_BASE_URL=https://api.aimlapi.com/v1
OPENAI_MODEL=gpt-4o-mini

# App
# Local: http://localhost:3000
# Production: https://www.tenthproject.com  (use www — apex 307s and breaks Stripe webhooks)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DEMO_USER_ID=your-demo-supabase-user-uuid

# Stripe — Lifetime membership checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_LIFETIME_PRICE_ID=
NEXT_PUBLIC_SKOOL_URL=https://www.skool.com/second-life-lab-6495/about

# Resend — emails professor.cat.hk@gmail.com for enterprise leads, new sales, and abandoned checkout
# Free sandbox can only send TO the Resend account email. Sign up with professor.cat.hk@gmail.com.
# Without this key the lead/sale is still saved; only the email is skipped.
RESEND_API_KEY=re_...
# Optional. Default sandbox sender (no custom domain required):
RESEND_FROM=Tenth Project <onboarding@resend.dev>
# Optional override; default is professor.cat.hk@gmail.com
LEAD_NOTIFY_EMAIL=professor.cat.hk@gmail.com
